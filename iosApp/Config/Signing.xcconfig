// Identity of the app. CI and release builds override these on the xcodebuild command line,
// e.g. `xcodebuild ... AIRCHESS_BUNDLE_ID=com.example.airchess DEVELOPMENT_TEAM=ABCDE12345`.
AIRCHESS_BUNDLE_ID = com.airchess
DEVELOPMENT_TEAM =

PRODUCT_BUNDLE_IDENTIFIER = $(AIRCHESS_BUNDLE_ID)
CODE_SIGN_STYLE = Automatic

// `//` starts a comment in xcconfig files, so the scheme separator is spelled with $().
AIRCHESS_SERVER_URL = wss:/$()/krakenper-gambit.exe.xyz/ws
